# Copiar a backend/.env para desarrollo local (backend/.env está ignorado por git).
# Valores de ejemplo: NO usar en producción.

# Django
DJANGO_DEBUG=True
# Obligatoria con DJANGO_DEBUG=False (en Render se genera sola).
DJANGO_SECRET_KEY=
# Hosts adicionales separados por comas (en Render se agrega RENDER_EXTERNAL_HOSTNAME).
DJANGO_ALLOWED_HOSTS=
DJANGO_CSRF_TRUSTED_ORIGINS=
# Solo para pruebas locales sin HTTPS con DJANGO_DEBUG=False.
# DJANGO_SECURE_SSL_REDIRECT=False

# Base de datos PostgreSQL. Vacía = SQLite local (backend/db.sqlite3).
# La URL de Neon va SOLO en .env.produccion (también ignorado), nunca aquí.
# Formato: postgresql://USUARIO:CLAVE@HOST/BASE?sslmode=require
DATABASE_URL=

# Superusuario inicial (lo crea entrypoint.sh si se define el usuario)
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=

# Vigencia de los tokens JWT
JWT_ACCESS_MINUTOS=30
JWT_REFRESH_HORAS=8

# Datos de la empresa para el encabezado de los libros exportados (T7.1). Ficticios.
EMPRESA_NOMBRE=Banco Demostración, S.A.
EMPRESA_NIT=0614-150395-101-7
EMPRESA_NRC=123456-7
